{
  "name": "mysql-jdbc-sink",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "1",

    "topics.regex": "mysqlserver1\\.cdc-sdb\\..+",

    "connection.url": "${env:MYSQL_SINK_URL}",
    "connection.user": "${env:MYSQL_SINK_USER}",
    "connection.password": "${env:MYSQL_SINK_PASSWORD}",

    "table.name.format": "${topic}",

    "auto.create": "true",
    "auto.evolve": "true",
    "delete.enabled": "true",
    "insert.mode": "upsert",
    "pk.mode": "record_key",
    "pk.fields": "id",

    "consumer.override.auto.offset.reset": "earliest",
    "consumer.override.isolation.level": "read_committed",

    "transforms": "drop,convertTS,convertDT,router",

    "transforms.drop.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
    "transforms.drop.blacklist": "source,ts_ms,op,transaction,__deleted",

    "transforms.convertTS.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.convertTS.field": "test_ts",
    "transforms.convertTS.target.type": "Timestamp",
    "transforms.convertTS.format": "yyyy-MM-dd'T'HH:mm:ss'Z'",

    "transforms.convertDT.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.convertDT.target.type": "string",
    "transforms.convertDT.field": "test_dt",
    "transforms.convertDT.format": "yyyy-MM-dd HH:mm:ss",

    "transforms.router.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.router.regex": ".*\\.([^\\.]+)$",
    "transforms.router.replacement": "$1",

    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "connect-dead-letter-queue",
    "errors.deadletterqueue.context.headers.enable": "true",

    "errors.log.enable": "true",
    "errors.log.include.messages": "true",
    "errors.retry.timeout": "-1",

    "db.timezone": "Asia/Seoul"
  }
}

